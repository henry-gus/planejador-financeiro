# --- Dados financeiros pessoais: NUNCA versionar ---
# Ignora tudo em data/, exceto a pasta de exemplos sintéticos
data/*
!data/sample/

# Segurança extra: qualquer CSV fica de fora, exceto exemplos sintéticos
*.csv
!data/sample/*.csv

# Bancos locais
*.db
*.sqlite
*.sqlite3

# --- Testes: mantidos apenas localmente ---
tests/

# --- Segredos e configuração local ---
.env
.env.*
!.env.example

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# --- Cobertura e caches de teste ---
.pytest_cache/
.coverage
htmlcov/

# --- Editores e sistema ---
.vscode/
.idea/
.DS_Store
Thumbs.db